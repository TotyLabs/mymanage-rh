# ==========================================
# MYMANAGE - PRODUCTION .gitignore
# ==========================================

# ---- SECRETS / ENVIRONMENT ----
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
*.jks

# ---- JAVASCRIPT / NODE ----
node_modules/
dist/
build/

# ---- PYTHON ----
__pycache__/
*.py[cod]
*$py.class

venv/
.venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- LOGS / RUNTIME ----
*.log
logs/
log/
*.pid
*.sock

# ---- TEMPORARY FILES ----
*.tmp
*.temp
*.swp
*.swo
*~

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- BACKUPS ----
backup/
backups/
*_backup/
*-backup/

# ---- PRODUCTION / LOCAL DATA ----
storage/
temp/
tmp/

# ---- DATABASE DUMPS / BACKUPS ----
*.sql
*.dump
*.backup
*.bak

# ---- LOCAL IMPORT / EXPORT FILES ----
*.xlsx
*.xls
*.csv

# ---- OPERATIONAL / DEBUG OUTPUT ----
db_output*.txt
logs_*.txt
logs_servicio_*.txt
*investigation*.txt

# ---- SCRATCH / LOCAL SCRIPTS ----
scratch/

# ---- PRODUCTION MIGRATION PAYLOADS / RESULTS ----
scripts/migrations/*.json

# ---- GENERATED PDFS ----
*.pdf

# EXCEPTION:
# Los PDFs oficiales de plantillas laborales SÍ deben permanecer
# versionados en el repositorio.
!Modelos Laborales/
!Modelos Laborales/*.pdf
